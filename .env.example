# Server Configuration
PORT=3002
NODE_ENV=development

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3002

# Twilio Configuration (OPTIONAL - Leave empty for MOCK mode)
# Get credentials from https://www.twilio.com/console
# If not provided, system will simulate calls/SMS in console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Force mock mode even if credentials exist (true/false)
MOCK_MODE=true
